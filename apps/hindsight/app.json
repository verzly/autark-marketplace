{
  "schema": 1,
  "id": "hindsight",
  "name": "Hindsight",
  "description": "Local memory API with ONNX embeddings, FlashRank and embedded PostgreSQL. Requires a running OpenAI-compatible LLM.",
  "version": "2026.11.0",
  "homepage": "https://github.com/vectorize-io/hindsight",
  "license": "MIT",
  "settings": [
    {
      "key": "port",
      "label": "API port",
      "kind": "port",
      "default": 8890,
      "help": "The API listens only on 127.0.0.1."
    },
    {
      "key": "llm_base_url",
      "label": "LLM base URL",
      "kind": "text",
      "default": "http://127.0.0.1:8888/v1",
      "help": "OpenAI-compatible endpoint, including /v1. Start the LLM server separately."
    },
    {
      "key": "llm_model",
      "label": "LLM model ID",
      "kind": "text",
      "default": "gpt-oss-20b",
      "help": "Use the exact model ID served by your LLM endpoint."
    },
    {
      "key": "llm_api_key_file",
      "label": "LLM API key file",
      "kind": "path",
      "default": "{app}/llm-api-key.txt",
      "help": "Type the full path to a UTF-8 file containing only the LLM key. Never enter the key itself here."
    }
  ],
  "setup": {
    "tools": {
      "python": "3.12",
      "uv": "0.13.1"
    },
    "installed_check": "{app}/venv/Scripts/hindsight-api.exe",
    "version_check": [
      "{app}/venv/Scripts/python.exe",
      "-I",
      "-c",
      "import importlib.metadata; print(importlib.metadata.version('hindsight-api-slim'))"
    ],
    "steps": [
      {
        "name": "Create Python environment",
        "run": ["uv", "venv", "--python", "3.12", "{app}/venv"]
      },
      {
        "name": "Install Hindsight with ONNX, FlashRank and embedded PostgreSQL",
        "run": [
          "uv", "pip", "install",
          "--python", "{app}/venv/Scripts/python.exe",
          "hindsight-api-slim[local-onnx,embedded-db]==1.3.0",
          "flashrank==0.2.10",
          "pg0-embedded==0.17.0"
        ]
      }
    ]
  },
  "launch": {
    "run": [
      "{app}/venv/Scripts/python.exe",
      "-I",
      "-c",
      "import os, sys\nfrom pathlib import Path\ntry:\n    key = Path(os.environ['AUTARK_HINDSIGHT_KEY_FILE']).read_text(encoding='utf-8-sig').strip()\nexcept (OSError, UnicodeError):\n    sys.exit('Cannot read the LLM API key file. Check the LLM API key file setting and UTF-8 encoding.')\nif not key:\n    sys.exit('The LLM API key file is empty.')\nos.environ['HINDSIGHT_API_LLM_API_KEY'] = key\nfrom hindsight_api.main import main\nmain()",
      "--host", "127.0.0.1",
      "--port", "{settings.port}"
    ],
    "url": "http://127.0.0.1:{settings.port}/docs"
  },
  "env": {
    "AUTARK_HINDSIGHT_KEY_FILE": "{settings.llm_api_key_file}",
    "HINDSIGHT_API_DATABASE_URL": "pg0://hindsight",
    "HINDSIGHT_API_LLM_PROVIDER": "openai",
    "HINDSIGHT_API_LLM_BASE_URL": "{settings.llm_base_url}",
    "HINDSIGHT_API_LLM_MODEL": "{settings.llm_model}",
    "HINDSIGHT_API_LLM_MAX_CONCURRENT": "1",
    "HINDSIGHT_API_EMBEDDINGS_PROVIDER": "onnx",
    "HINDSIGHT_API_EMBEDDINGS_ONNX_MODEL_ID": "intfloat/multilingual-e5-small",
    "HINDSIGHT_API_EMBEDDINGS_ONNX_DIMENSIONS": "384",
    "HINDSIGHT_API_RERANKER_PROVIDER": "flashrank",
    "HINDSIGHT_API_RERANKER_FLASHRANK_CACHE_DIR": "{app}/cache/flashrank",
    "PG0_HOME": "{app}/pg0",
    "PG0_INSTALLATION_DIR": "{app}/pg0/installation",
    "HF_HOME": "{app}/cache/huggingface",
    "HF_HUB_CACHE": "{app}/cache/huggingface/hub",
    "XDG_CACHE_HOME": "{app}/cache",
    "UV_CACHE_DIR": "{app}/cache/uv"
  }
}
